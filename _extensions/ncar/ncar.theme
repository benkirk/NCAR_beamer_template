{
    "text-color": "#011837",
    "background-color": "#F1F0EE",
    "line-number-color": "#6B7C99",
    "line-number-background-color": null,
    "text-styles": {
        "Keyword":        { "text-color": "#0057C2", "bold": true },
        "ControlFlow":    { "text-color": "#0057C2", "bold": true },
        "DataType":       { "text-color": "#00357A" },
        "BuiltIn":        { "text-color": "#00357A" },
        "Function":       { "text-color": "#00357A", "bold": true },
        "Operator":       { "text-color": "#011837" },
        "DecVal":         { "text-color": "#00818F" },
        "BaseN":          { "text-color": "#00818F" },
        "Float":          { "text-color": "#00818F" },
        "Constant":       { "text-color": "#00818F" },
        "Char":           { "text-color": "#00818F" },
        "SpecialChar":    { "text-color": "#00818F" },
        "String":         { "text-color": "#00818F" },
        "VerbatimString": { "text-color": "#00818F" },
        "SpecialString":  { "text-color": "#00818F" },
        "Import":         { "text-color": "#0057C2" },
        "Preprocessor":   { "text-color": "#0057C2" },
        "Attribute":      { "text-color": "#00357A" },
        "Variable":       { "text-color": "#011837" },
        "Extension":      { "text-color": "#011837" },
        "Other":          { "text-color": "#00357A" },
        "Comment":        { "text-color": "#6B7C99", "italic": true },
        "Documentation":  { "text-color": "#6B7C99", "italic": true },
        "Annotation":     { "text-color": "#6B7C99", "italic": true, "bold": true },
        "CommentVar":     { "text-color": "#6B7C99", "italic": true, "bold": true },
        "Information":    { "text-color": "#6B7C99", "italic": true, "bold": true },
        "Warning":        { "text-color": "#B5540A", "italic": true, "bold": true },
        "Alert":          { "text-color": "#B5540A", "bold": true },
        "Error":          { "text-color": "#B5540A", "bold": true },
        "RegionMarker":   { "text-color": "#6B7C99" }
    }
}
